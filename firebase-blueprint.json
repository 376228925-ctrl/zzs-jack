{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated pickleball player profile with isolated personal preferences and role metadata.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching document ID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Player display name matched to tournament rosters."
        },
        "gender": {
          "type": "string",
          "enum": ["M", "F", "U"],
          "description": "Player gender for mixed doubles matchmaking."
        },
        "dupr": {
          "type": "number",
          "description": "Self-reported or calibrated DUPR skill rating (2.0 to 6.0)."
        },
        "paddle": {
          "type": "string",
          "maxLength": 48,
          "description": "Preferred pickleball paddle model."
        },
        "playStyle": {
          "type": "string",
          "maxLength": 48,
          "description": "Player tactical style label."
        },
        "bio": {
          "type": "string",
          "maxLength": 160,
          "description": "Short personal bio."
        },
        "role": {
          "type": "string",
          "enum": ["player", "admin", "super_admin"],
          "description": "Display role mirrored from trusted admin records; users can only initialize as player."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "displayName", "gender", "dupr", "role", "createdAt", "updatedAt"]
    },
    "AdminGrant": {
      "title": "AdminGrant",
      "description": "Trusted RBAC document granting tournament publishing privileges. Managed exclusively by super_admin.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "role": {
          "type": "string",
          "enum": ["admin", "super_admin"]
        },
        "grantedBy": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "role", "grantedBy", "createdAt"]
    },
    "TournamentSession": {
      "title": "TournamentSession",
      "description": "A calendar-dated pickleball round-robin tournament session published by an admin.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sessionDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Calendar date in YYYY-MM-DD format."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "venue": {
          "type": "string",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": ["draft", "published", "completed"]
        },
        "createdBy": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByName": {
          "type": "string",
          "maxLength": 32
        },
        "config": {
          "type": "object",
          "description": "Tournament format, courtCount, totalRounds, targetScore, winByTwo, roundMinutes."
        },
        "players": {
          "type": "array",
          "description": "Bounded roster of players in this session (max 48)."
        },
        "rounds": {
          "type": "array",
          "description": "Bounded rounds list (max 20)."
        },
        "seed": {
          "type": "number"
        },
        "rosterDirty": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "sessionDate",
        "title",
        "status",
        "createdBy",
        "config",
        "players",
        "rounds",
        "seed",
        "rosterDirty",
        "createdAt",
        "updatedAt"
      ]
    },
    "PersonalAiReview": {
      "title": "PersonalAiReview",
      "description": "Owner-isolated personal AI coaching review saved by a player.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "playerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "headline": {
          "type": "string",
          "maxLength": 120
        },
        "trendSummary": {
          "type": "string",
          "maxLength": 600
        },
        "strengths": {
          "type": "string",
          "maxLength": 600
        },
        "focusAreas": {
          "type": "string",
          "maxLength": 600
        },
        "trainingPlan": {
          "type": "array",
          "description": "Bounded list of up to 5 training drills."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "playerName",
        "headline",
        "trendSummary",
        "strengths",
        "focusAreas",
        "trainingPlan",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private player profiles isolated by ownerId (or readable by admins for roster management)."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminGrant" },
      "description": "Trusted RBAC allowlist determining tournament publishers; writable only by super_admin."
    },
    "/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/TournamentSession" },
      "description": "Multi-day calendar tournament sessions; published sessions readable by club members, writable only by admins."
    },
    "/personal_records/{recordId}": {
      "schema": { "$ref": "#/entities/PersonalAiReview" },
      "description": "Owner-isolated personal AI match review archive."
    }
  }
}
